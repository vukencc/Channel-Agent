# 可选的独立监督器配置；启用时才复制为 .env.supervisor 并填写凭据。
SUPERVISOR_ENABLED=true
SUPERVISOR_API_KEY=
SUPERVISOR_BASE_URL=
SUPERVISOR_MODEL=
# 小额度 JSON 监督请求若模型会消耗推理额度，可显式设为 disabled；auto 保持默认行为。
SUPERVISOR_THINKING_MODE=auto
SUPERVISOR_TIMEOUT=20
SUPERVISOR_MAX_INPUT_CHARS=12000
SUPERVISOR_MAX_OUTPUT_TOKENS=1200
SUPERVISOR_CHECK_INTERVAL=3
SUPERVISOR_VARIANCE_THRESHOLD=0.75
SUPERVISOR_MAX_CHUNKS=24
SUPERVISOR_INPUT_COST_PER_MILLION=0
SUPERVISOR_OUTPUT_COST_PER_MILLION=0
