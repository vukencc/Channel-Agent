# ---- 模型服务 ----
OPENCODE_API_KEY=
BASE_URL=https://opencode.ai/zen/go/v1
MODEL=deepseek-v4.1-flash
REASONING_EFFORT=low
# auto 不覆盖服务商默认；enabled/disabled 仅适用于支持 thinking 扩展的服务商
THINKING_MODE=disabled

# ---- 网络与重试 ----
TIMEOUT=30.0
# 大工具参数可能在服务端生成后整段返回；空闲时限不同于下方总时限
SESSION_TIMEOUT=60.0
MAX_RETRIES=2
# 覆盖连接、重试和流生成的单次模型调用总时限（秒）
MODEL_CALL_TIMEOUT=90
# 可选 RAG 后台评估总时限，不阻塞继续对话
ASSESS_TIMEOUT=30

# ---- 调试 ----
DEBUG=False
# 仅显式启用时向模型注册随机数调试工具
ENABLE_DEBUG_TOOL=False

# ---- 联网搜索工具（Tavily）----
WEB_SEARCH_API_KEY=

# ---- RAG ----
# 知识库目录，相对路径以项目根为基准
DOC_DIR=data/raw # Raw data
# RAG 评估开关：True 时由 LLM 统一对每轮 RAG 做评估并输出结果
RAG_ASSESS=False
HF_ENDPOINT=https://hf-mirror.com

# ---- Embedding 模型 ----
# LOCAL = 本地模型（fastembed，无需联网/Key）；API = 云端 OpenAI 兼容 /embeddings 接口
EMBEDDING_MODEL_SOURCE=LOCAL
# 以下三项仅在 EMBEDDING_MODEL_SOURCE=API 时使用
EMBEDDING_MODEL_URL=
EMBEDDING_MODEL_API_KEY=
EMBEDDING_MODEL_NAME=text-embedding-3-small

# ---- 工具沙箱与命令执行 ----
# 文件 CRUD 与命令执行的活动范围（相对项目根），必须在沙箱内操作
SANDBOX_DIR=crud_tests
# 风险操作确认等待秒数；超时按拒绝处理
CONFIRM_TIMEOUT=30.0
# 单条命令最长执行秒数
COMMAND_TIMEOUT=10.0
# 工具输出（命令/文件内容）最大字符数，超出截断
TOOL_MAX_OUTPUT=20000
# 文件按字符分页，返回 next_offset 可继续读取；长文件使用 edit_file 修改
FILE_READ_CHARS=6000
# 仅限制发给模型的工作上下文，完整会话仍保存在磁盘；字符数不是 token 数
MODEL_INPUT_CHARS=64000
# 单次流的正文、推理与工具参数总字符上限，超限不执行不完整工具
MODEL_OUTPUT_CHARS=48000
# 无 ToolContext 时的审计日志；CLI 使用 AGENT_STATE_DIR/<id>/audit.jsonl
AUDIT_LOG=logs/audit.log

# ---- 混合检索：向量 + BM25 -> RRF -> 重排 ----
RAG_CACHE_DIR=.cache/rag
RAG_CANDIDATES=50
RAG_RERANK_TOP_N=50
RAG_RRF_K=60
RAG_PARENT_CHARS=600
RAG_CHILD_CHARS=240
RAG_BATCH_SIZE=32
RAG_THREADS=4
# 0 保持共享工具池；显式 1 或 2 启用独立 RAG 线程池与并发额度。
# 超时计算实际退出前仍占额度；不改变工具确认、取消与审计。
RAG_INFERENCE_CONCURRENCY=0
# 显式启用稳定系统前缀，动态记忆/剩余轮次/摘要移至请求尾部。
# 服务商是否命中缓存取决于其能力；不注入未验证的专有 cache_control 参数。
MODEL_STABLE_PREFIX=false
# null 全部工具（默认），[] 无工具，或如 ["read_file","rag_search"]。
# /tools 可按会话覆盖并持久化；不在子集的调用会拒绝并审计，写工具仍须确认。
MODEL_TOOL_NAMES=null
# 命名只读根；默认仅会话工作区。路径相对仓库或绝对路径，只允许 read_only=true。
# 例：{"docs":{"path":"docs","read_only":true}}，文件工具用 @docs/文件，rag_search 用 source="@docs"。
# 不挂载给命令沙箱，不支持额外可写根；未知根、../ 与越界软链拒绝。
TOOL_ROOTS={}
# 命名知识库只读目录；模型沿用全局配置，可单独配置已有三档阈值。
# 例：{"manual":{"path":"docs","thresholds":{"strict":0,"normal":-2,"loose":-10}}}
# 不自动导入/改写数据；source 留空保持 DOC_DIR。updated_after 按文件 mtime 过滤，必须带时区。
RAG_SOURCES={}
RAG_MAX_TOP_K=50
# standard 保持逐次确认；readonly 拒绝写/命令；trusted 仅使用显式预先确认规则。
# /policy 可按会话覆盖并持久化。trusted 未匹配仍请求确认；路径/沙箱边界永远保留。
TOOL_PERMISSION_POLICY=standard
# 示例 [{"tool":"create_file","path_prefix":"notes"},{"tool":"run_command","command_prefix":["printf"]}]
# 命令按 argv 前缀匹配，插值/重定向/管道/多行不自动批准；规则不是主机执行许可。
TOOL_PERMISSION_RULES=[]
# Headless 显式入口：uv run main.py --prompt "任务" --json --state-dir <目录>
# 默认 standard 且立即拒绝待确认操作，不继承 trusted 自动批准；仅 --policy trusted 使用配置的预先确认规则。
# --session <唯一 ID 前缀> 可恢复会话；无 --prompt 时仍启动原 TUI。
# 可选：已有 FastEmbed ONNX 模型目录（包含 tokenizer.json / model_optimized.onnx）
EMBEDDING_LOCAL_PATH=
RERANK_MODEL=cross-encoder/mmarco-mMiniLMv2-L12-H384-v1
RERANK_REVISION=
RERANK_LOCAL_PATH=
# 原始 cross-encoder logit，非概率；修改阈值或模型须附 dev.rag.quality 校准/留出报告
# 小候选池建议不能直接当作全库阈值，默认值不自动覆盖
RAG_THRESHOLD_STRICT=0.0
RAG_THRESHOLD_NORMAL=-2.0
RAG_THRESHOLD_LOOSE=-10.0

# Multi-session CLI: history/memory in AGENT_STATE_DIR; tool files in SANDBOX_DIR/<session-id>
AGENT_STATE_DIR=.agent
# 可选：覆盖仓库根目录（默认从 src/ai_agent_startup/ 自动上溯）；容器或非常规部署使用
AI_AGENT_PROJECT_ROOT=
# 前台模型调用并发数；等待确认与工具执行不占槽
MAX_CONCURRENT_AGENTS=4
MAX_TOOL_ROUNDS=24

# 持久记忆上限；旧文件仅截断注入，完整内容可导出
MEMORY_MAX_CHARS=4000

# 后台评估使用独立池
ASSESS_CONCURRENCY=1
# 摘要/评估/记忆提取共用此辅助模型；留空沿用主模型，端点仍为 BASE_URL。
AUX_MODEL=
# 0 沿用 ASSESS_TIMEOUT；参数覆盖沿用已支持的 MODEL_PARAMETERS 字段。
AUX_TIMEOUT=0
AUX_MODEL_PARAMETERS={}
# 0 不另设辅助总并发；正整数限制所有辅助请求，不占主模型额度。
AUX_CONCURRENCY=0
# 0 保持与评估共用额度；正整数使记忆提取使用独立额度。
MEMORY_CONCURRENCY=0
# 显式启用记忆 scope/add/search/edit 管理；默认原隔离、64 条/字符上限与人工采纳不变。
# 到期条目保留在文件中，但启用管理后不再注入模型；不会自动清理或采纳候选。
ENABLE_MEMORY_MANAGEMENT=false
# 显式启用 /branch [消息编号]、/resend 编号 新文本、/retry。
# 总是创建新会话和空工作区，复制对话前缀与独立记忆快照；不复制/共享原工作区，不原地编辑历史。
ENABLE_SESSION_BRANCHES=false
# 后台摘要显式开启；首次缓存未命中使用省略说明，摘要完成后供后续请求使用。
CONTEXT_SUMMARY_BACKGROUND=false
SUMMARY_CONCURRENCY=1
# 不同辅助模型的美元/百万 token 单价；0 表示未知，启用费用预算时会拒绝未知价格请求。
# 辅助模型与主模型相同时，0 沿用主模型单价。
AUX_INPUT_COST_PER_MILLION=0
AUX_OUTPUT_COST_PER_MILLION=0

# 出网前展示完整 query 并确认；off 仅由用户显式配置
WEB_SEARCH_CONFIRM=always
WEB_SEARCH_TIMEOUT=15

# 命令资源兜底；prlimit 不可用时拒绝执行
WORKSPACE_LIMIT_MB=512
COMMAND_MEMORY_MB=512
COMMAND_CPU_SECONDS=5
COMMAND_FILE_MB=32
COMMAND_PROCESSES=128

# 启动会校验模型三要素、目录和数值；数值须为有限正数（阈值可为负）。
# --list 只读列表不要求模型凭据。

# 字符与近似 token 双预算；不是服务商精确 tokenizer
MODEL_INPUT_TOKENS=16000
CONTEXT_SUMMARY=True
SUMMARY_INPUT_CHARS=12000
SUMMARY_CHARS=1000
SUMMARY_TIMEOUT=10

# append_file 分段上限固定为 4000 字符，每段确认、原子保存并校验字符偏移。

# 达到此会话体积后拒绝新轮次；在途结果继续保存，请导出归档并新建会话
SESSION_MAX_MB=64

# 连续只读工具并发；写工具仍串行。超额调用回填拒绝结果保持配对。
MAX_TOOL_CALLS_PER_ROUND=8
TOOL_CONCURRENCY=4
TOOL_TIMEOUT=120

# DOC_DIR 支持 txt/md/html；PDF/Word 需额外解析器，缺失会警告并跳过。
# 文件缓存使用 size/mtime_ns/ctime_ns/inode，变更后才读取和哈希。

# 文件记忆：BM25 相关选择，无命中提供有界摘录；自动提取仅保存待采纳候选
MEMORY_TOP_K=4
MEMORY_INJECT_CHARS=1200
MEMORY_AUTO_EXTRACT=False
# 显式启用后使用状态根目录 shared-memory.md，原会话记忆仍保留
MEMORY_SHARED=False

# 可选同协议备用模型；仅流开始前的瞬时故障才切换，默认保持单模型
# 示例：[{"model":"backup","base_url":"https://example.org/v1","api_key_env":"BACKUP_API_KEY"}]
MODEL_FALLBACKS=[]
# 服务商支持时开启流式 usage，否则使用近似计数
MODEL_STREAM_USAGE=False
# 美元/百万 token；0 表示未配置价格，成本记录 null，不能视为免费
INPUT_COST_PER_MILLION=0
OUTPUT_COST_PER_MILLION=0

# 后台评估总输入/单片段预算；不足则明确降级，不影响回答
ASSESS_INPUT_CHARS=12000
ASSESS_CONTEXT_CHARS=2000

# 最近已完成轮次的指标环形历史；不包含模型正文副本
RUN_HISTORY_LIMIT=20

# RAG 在阶段/批次间响应停止；在途原生推理不可强杀，批量大小由 RAG_BATCH_SIZE 控制。

# Headless/API/MCP/多模态目前只有 docs/platform-design.md 设计，没有运行开关。

# 可选质量集成测试：RAG_QUALITY_CORPUS=/绝对路径/corpus.parquet（应用启动不需要）。
# 默认 CI 运行离线测试；手动 workflow_dispatch 才下载公开模型并执行 integration。
# 会话列表仅加载元数据；访问目标历史时恢复。无需新增开关，v1 首次保存仍会迁移。

# 上下文仅复制修改字段并复用序列化计量；现有 MODEL_INPUT_* 预算保持不变。

# 命令运行期间配额扫描间隔（秒）；开始、确认后、结束仍强制检查。
# 默认保留 0.1s 采样；可显式设为 1 降低大目录 IO，但会扩大配额发现延迟。
COMMAND_QUOTA_INTERVAL=0.1

# 默认直接追加到内核、不做用户态缓冲；true 每条事件 fsync，增强断电持久性，增加 IO。
AUDIT_SYNC=false

# v2 会话导出逐消息流式写入，仍然 fsync 后原子发布；无需开关。

# 显式注册 mkdir/move/copy/stat/glob；写入仍确认+审计，不覆盖已有目标。
ENABLE_FILE_EXTRAS=false

# 默认不额外发送采样参数，tool_choice 仍 auto。可选 temperature/top_p/max_tokens/
# parallel_tool_calls/response_format({"type":"text|json_object"})/tool_choice(auto|none|required)。
MODEL_PARAMETERS={}
# 命名预设使用 /model 名称 选择并随会话保存；不会覆盖沙箱或写入确认。
# 示例：{"precise":{"model":"your-model","parameters":{"temperature":0.2,"tool_choice":"auto"}}}
MODEL_PROFILES={}

# 美元估算预算；0 不限。正值要求目标模型的输入/输出单价均已知且大于 0。
# 每次实际请求（含重试、摘要/评估）先预留；有 provider usage 才按统计结算。
# 中断或缺少 usage 保留预留费用；不是服务商账单硬上限。UTC 日额度共享于状态目录。
SESSION_COST_LIMIT=0
DAILY_COST_LIMIT=0
# 状态目录内所有会话合计、滚动 60 秒请求次数，0 不限。
MODEL_REQUESTS_PER_MINUTE=0

# append_file 的 schema/运行时校验与提示词共用上限；修改后重启。
FILE_APPEND_CHARS=4000
# 提示词中的检索重试建议；实际执行仍受全局工具轮次预算约束。
RAG_RETRY_LIMIT=2
# 可选自定义新会话系统提示 UTF-8 文件；留空使用内置模板。不会替换已有会话提示。
SYSTEM_PROMPT_FILE=

# 默认 CPU/fp32；auto 显式自动探测，cuda/mps 不可用时报错，不静默换设备。
RAG_RERANK_DEVICE=cpu
RAG_RERANK_DTYPE=fp32
# 0 禁用；缓存只保存真实推理结果，按模型/查询/段落内容隔离并有界淘汰。
RAG_RERANK_CACHE_SIZE=0
RAG_QUERY_CACHE_SIZE=0
# 默认使用 RAG_RERANK_TOP_N；可显式按宽度设候选数，如 {"narrow":20,"normal":30,"wide":50}。
# 减候选可能影响召回，请先测公开质量集；缓存基准保持默认 50 个候选。
RAG_RERANK_BY_BREADTH={}

# 默认精确检索；ann 需 uv sync --locked --extra ann。加载/查询失败会记录警告并回退 exact。
# trace.vector_backend 记录实际后端；近似召回必须单独评估，不能视为与 exact 等价。
RAG_VECTOR_BACKEND=exact
RAG_ANN_MIN_CHILDREN=10000
RAG_ANN_M=16
RAG_ANN_EF_CONSTRUCTION=200
RAG_ANN_EF_SEARCH=256

# 可选 SQLite 增量 BM25：持久化分词/倒排表，更新后发布 WAL 读快照；默认原内存 BM25。
RAG_BM25_PERSIST=false

# 0 保持现状；正值启用正文/父子块按需磁盘存储、共享字节 LRU、SQLite BM25 和 Linux RSS 准入检查。
# 文本/分块缓存合计最多 min(64MiB, 预算/4)。模型/其他会话也占进程 RSS；预算不足明确拒绝。
# 是分配边界上的软准入保护，不是 cgroup 硬限制；并发/原生推理期间可能短暂超过预算。
RAG_MEMORY_LIMIT_MB=0

# FREE-02：联网与后台命令均显式启用；仍使用 Bubblewrap 私有网络与资源限制
COMMAND_NETWORK=off
# 白名单仅允许解析为公网单播；拒绝内网、组播、保留及 IPv6 过渡地址。
COMMAND_NETWORK_ALLOWLIST=[]
COMMAND_NETWORK_MAX_BYTES=8388608
COMMAND_NETWORK_MAX_CONNECTIONS=4
COMMAND_NETWORK_TIMEOUT=5
ENABLE_COMMAND_JOBS=false
COMMAND_JOB_MAX_SECONDS=300
COMMAND_JOB_CONCURRENCY=1
COMMAND_JOB_MAX_ACTIVE=16
COMMAND_JOB_LOG_BYTES=262144

# FREE-06：会话预算覆盖由 /config 设置并持久化；不改变沙箱配额
ENABLE_SESSION_BUDGETS=false
MODEL_RECOVERY_LIMIT=1

# Agent 通信限制：每条消息字符数与单个收件箱 UTF-8 文件字节数；均须为正整数，信箱满时拒绝新消息并保留历史
SESSION_MESSAGE_MAX_CHARS=4000
SESSION_INBOX_MAX_BYTES=1048576

# FREE-11：旧版单进程委派队列；同时需要 ENABLE_SESSION_BUDGETS=true
ENABLE_AGENT_TASKS=false
AGENT_TASK_CONCURRENCY=2
AGENT_TASK_MAX_ACTIVE=16

# FREE-12：图片可选能力；仅填写已验证支持视觉的当前服务模型名称
# 图片轮次的 /retry、/resend 保留附件；仍仅发送给原批准模型/服务。
ENABLE_IMAGE_INPUT=false
VISION_MODELS=[]
IMAGE_MAX_BYTES=5242880
IMAGE_MAX_PIXELS=4000000
IMAGE_MAX_PER_REQUEST=4
IMAGE_TOKEN_BUDGET=4096
IMAGE_TOTAL_MB=32

# FREE-14：只读观测命令；不展示正文和工具参数，不改变持久日志格式
ENABLE_OBSERVABILITY=false
TRACE_MAX_ROWS=20
TRACE_MAX_FIELD_CHARS=512

# FREE-15：无新增开关。命令仅 Linux/WSL2 + bwrap/prlimit；其他平台 fail-closed。
# uv run main.py --platform 显示静态能力；实际隔离验证用 dev/ci_sandbox_probe.py。
